    <ImageView
        android:id="@+id/iv_black_watch"
        android:layout_width="80dp"
        android:layout_height="140dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/label_watch"
        app:srcCompat="@drawable/bkg_black_watch"
        android:alpha="0.2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="32dp"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:text="@string/app_name"/>

    <View
        android:id="@+id/view_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginEnd="160dp"
        app:layout_constraintTop_toBottomOf="@id/tv_app_name"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="10dp"
        android:alpha="0.2"
        android:background="@color/text_secondary"/>

    <ImageView
        android:id="@+id/btn_header_settings"
        android:layout_width="24dp"
        android:layout_height="32dp"
        android:contentDescription="@string/menu_title_3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:background="?android:attr/actionBarItemBackground"
        app:srcCompat="@drawable/ic_nav_settings"/>

    <ImageView
